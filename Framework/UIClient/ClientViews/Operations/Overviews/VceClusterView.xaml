                    <TextBlock Text="{Binding PM1Temperature}" TextWrapping="Wrap" Foreground="{DynamicResource FG_Black}" FontSize="12" FontFamily="Arial" VerticalAlignment="Center"/>
                </Border>
            </Grid>



            <Grid x:Name="PM2_Info" Canvas.Left="918" Canvas.Top="57"   >
