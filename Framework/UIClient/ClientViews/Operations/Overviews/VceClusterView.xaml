                    <TextBlock Text="{Binding PM1StepLeftTime}" TextWrapping="Wrap" Foreground="{DynamicResource FG_Black}" FontSize="12" FontFamily="Arial" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{DynamicResource OverviewTable_LeftBottomBorder}" Grid.Row="6" Padding="5,1">
