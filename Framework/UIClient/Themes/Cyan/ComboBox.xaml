    <SolidColorBrush x:Key="TopToggleButton_BD" Color="#FF243664"/>
    <SolidColorBrush x:Key="TopToggleButton_BG" Color="#FF4B94A3"/>
    <SolidColorBrush x:Key="TopToggleButton_InnerHighlight" Color="#FF9FCDED"/>
    <SolidColorBrush x:Key="TopToggleButton_InnerShadow" Color="#FF003A62"/>
    <SolidColorBrush x:Key="TopToggleButton_BG_MouseOver" Color="#FF227BB8"/>
    <SolidColorBrush x:Key="TopComboBox_BG" Color="#FFC8E8FF"/>
