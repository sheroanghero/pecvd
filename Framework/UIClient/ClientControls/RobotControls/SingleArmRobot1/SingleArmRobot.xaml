<UserControl x:Class="MECF.Framework.UI.Client.ClientControls.RobotControls.SingleArmRobot1.SingleArmRobot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ctrl="http://OpenSEMI.Ctrlib.com/presentation" 
             xmlns:ctrlCommon="clr-namespace:MECF.Framework.UI.Client.ClientControls.Common"
             xmlns:efemControls="clr-namespace:MECF.Framework.UI.Client.ClientControls.EfemControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Viewbox Stretch="Uniform">
        <ctrlCommon:AxisCanvas   x:Name="root" Width="416" Height="46">
            <ctrlCommon:AxisCanvas.ContextMenu>
                <ContextMenu ItemsSource="{Binding Menu}" />
            </ctrlCommon:AxisCanvas.ContextMenu>
            <ctrlCommon:AxisCanvas   x:Name="canvas1" Height="46" Width="103">
                <Image Width="103" Height="46" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/SingleArmRobot1/armRoot.png" />
                <ctrlCommon:AxisCanvas x:Name="canvas2" Height="46" Width="92" Canvas.Left="78">
                    <Image Width="92" Height="39" Canvas.Top="3" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/SingleArmRobot1/arm.png" />
                    <ctrlCommon:AxisCanvas   x:Name="canvas3" Height="46" Width="185" Canvas.Left="57">
                        <Canvas>
                            <Image Width="185" Height="45" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/SingleArmRobot1/hand.png"/>
                            <!--<efemControls:WaferCtrl   Width="80" Height="80" WaferData="{Binding WaferData}" Canvas.Left="133" Canvas.Top="-18" />-->
                        </Canvas>
                    </ctrlCommon:AxisCanvas>
                </ctrlCommon:AxisCanvas>
            </ctrlCommon:AxisCanvas>
            <ctrlCommon:AxisCanvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform CenterY="23" Angle="{Binding RotateAngle}"></RotateTransform>
                    <TranslateTransform  x:Name="translate" X="{Binding TranslateX}"/>
                </TransformGroup>
            </ctrlCommon:AxisCanvas.RenderTransform>
        </ctrlCommon:AxisCanvas>
    </Viewbox>
</UserControl>
