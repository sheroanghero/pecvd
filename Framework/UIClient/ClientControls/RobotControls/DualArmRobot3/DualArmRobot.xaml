<UserControl x:Class="MECF.Framework.UI.Client.ClientControls.RobotControls.DualArmRobot3.DualArmRobot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:MECF.Framework.UI.Client.ClientControls.Common"
             xmlns:efemControls="clr-namespace:MECF.Framework.UI.Client.ClientControls.EfemControls"
             mc:Ignorable="d" 
             d:DesignHeight="124" d:DesignWidth="416">
    <Viewbox>
        <common:AxisCanvas Width="416" Height="99"  x:Name="root">
            <common:AxisCanvas.ContextMenu>
                <ContextMenu ItemsSource="{Binding Menu}" />
            </common:AxisCanvas.ContextMenu>
            <common:AxisCanvas x:Name="container" Width="416" Height="124">
                <Image Width="124" Height="122" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot3/robotDock.png" />
                <common:AxisCanvas x:Name="canvasRoot" Height="99" AxisLeft="50" Width="99" Canvas.Top="12" Canvas.Left="12">
                    <common:AxisCanvas x:Name="canvas1" Height="32" Width="99" Canvas.Top="32" Canvas.Left="34" AxisLeft="18">
                        <Image Width="32" Height="99" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot3/robotArm.png" RenderTransformOrigin="0.5,0.5" Canvas.Left="33" Canvas.Top="-33" >
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="90"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <common:AxisCanvas x:Name="canvas2" Height="32" Width="99" Canvas.Top="0" Canvas.Left="85">
                            <Image Width="32" Height="99" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot3/robotArm.png" RenderTransformOrigin="0.5,0.5" Canvas.Left="33" Canvas.Top="-33" >
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="90"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <common:AxisCanvas x:Name="canvas3" Height="37" Width="71" Canvas.Left="85" Canvas.Top="-3">
                                <Image Width="71" Height="37" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot3/robotHand.png" RenderTransformOrigin="0.5,0.5" >
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="180"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <efemControls:WaferCtrl WaferData="{Binding Wafer1}" Width="56" Height="56"  Canvas.Left="32" Canvas.Top="-10"/>
                            </common:AxisCanvas>
                        </common:AxisCanvas>
                    </common:AxisCanvas>
                    <common:AxisCanvas x:Name="canvas21" Height="32" Width="99" Canvas.Top="34" Canvas.Left="34" AxisLeft="18">
                        <Image Width="32" Height="99" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot3/robotArm.png" RenderTransformOrigin="0.5,0.5" Canvas.Left="33" Canvas.Top="-33" >
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="90"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <common:AxisCanvas x:Name="canvas22" Height="32" Width="99" Canvas.Left="85">
                            <Image Width="32" Height="99" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot3/robotArm.png" RenderTransformOrigin="0.5,0.5" Canvas.Left="33" Canvas.Top="-33" >
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="90"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <common:AxisCanvas x:Name="canvas23" Height="37" Width="71" Canvas.Left="85" Canvas.Top="-3">
                                <Image Width="71" Height="37" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot3/robotHand.png" RenderTransformOrigin="0.5,0.5" >
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="180"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <efemControls:WaferCtrl WaferData="{Binding Wafer2}" Width="56" Height="56"   Canvas.Left="32" Canvas.Top="-10"/>
                            </common:AxisCanvas>
                        </common:AxisCanvas>
                    </common:AxisCanvas>
                </common:AxisCanvas>
            </common:AxisCanvas>
        </common:AxisCanvas>
    </Viewbox>
</UserControl>