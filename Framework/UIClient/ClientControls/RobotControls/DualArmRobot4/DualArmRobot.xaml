<UserControl x:Class="MECF.Framework.UI.Client.ClientControls.RobotControls.DualArmRobot4.DualArmRobot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:MECF.Framework.UI.Client.ClientControls.Common"
             xmlns:controls="clr-namespace:OpenSEMI.Ctrlib.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="38" d:DesignWidth="416">
 
    <Viewbox x:Name="root" Stretch="Uniform">
        <Canvas Width="416" Height="38">
            <Image Width="38" Height="38" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot4/robotDock.png" />
            <common:AxisCanvas x:Name="canvas1" Height="21" Width="129" Canvas.Top="10" Canvas.Left="10">
                <Image Width="129" Height="21" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot4/robotArm.png" />
                <common:AxisCanvas x:Name="canvas2" Height="21" Width="129" Canvas.Left="110">
                    <Image Width="129" Height="21" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot4/robotArm.png" />
                    <common:AxisCanvas x:Name="canvas3" Height="38" Width="106" Canvas.Left="110" Canvas.Top="-10">
                        <Image Width="106" Height="38" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot4/robotHand.png" />
                        <!--<controls:Wafer WaferStyle="Eclipse" WaferItem="{Binding Wafer1}" Station ="{Binding Station}" Slot="0" Canvas.Left="62" Canvas.Top="-16" Height="69" Width="69"  />-->
                    </common:AxisCanvas>
                    <common:AxisCanvas x:Name="canvas23" Height="38" Width="106" Canvas.Left="110" Canvas.Top="-10">
                        <Image Width="106" Height="38" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot4/robotHand.png" />
                        <!--<controls:Wafer WaferStyle="Eclipse" WaferItem="{Binding Wafer2}" Station ="{Binding Station}" Slot="1" Canvas.Left="62" Canvas.Top="-16" Height="69" Width="69"  />-->
                    </common:AxisCanvas>
                </common:AxisCanvas>
            </common:AxisCanvas>
            <Canvas.RenderTransform>
                <RotateTransform CenterY="30" Angle="{Binding RotateAngle}"></RotateTransform>
            </Canvas.RenderTransform>
        </Canvas>
    </Viewbox>
</UserControl>
