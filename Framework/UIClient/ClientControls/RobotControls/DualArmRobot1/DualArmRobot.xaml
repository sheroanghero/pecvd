<UserControl x:Class="MECF.Framework.UI.Client.ClientControls.RobotControls.DualArmRobot1.DualArmRobot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ctrl="http://OpenSEMI.Ctrlib.com/presentation" 
             xmlns:ctrlCommon="clr-namespace:MECF.Framework.UI.Client.ClientControls.Common"
             xmlns:efemControls="clr-namespace:MECF.Framework.UI.Client.ClientControls.EfemControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <Viewbox Stretch="Uniform">
        <Canvas Width="309" Height="61"  x:Name="root">
            <Canvas.ContextMenu>
                <ContextMenu ItemsSource="{Binding Menu}" />
            </Canvas.ContextMenu>
            <ctrlCommon:AxisCanvas x:Name="canvasRoot"  Width="309" Height="61" >
                <ctrlCommon:AxisCanvas x:Name="canvas2" Height="23" Width="168" Canvas.Top="19" Canvas.Left="23" ShowAxisPoint="True">
                    <Image Stretch="None" Width="92"  Height="23" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo1.png"   Opacity=" 0.1" />
                    <ctrlCommon:AxisCanvas x:Name="canvas21" Height="19" Width="92" Canvas.Left="76" Canvas.Top="2" ShowAxisPoint="True">
                        <Image Width="92" Height="19" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo2.png"   />
                    </ctrlCommon:AxisCanvas>
                    <ctrlCommon:AxisCanvas x:Name="canvas22" Height="19" Width="92" Canvas.Left="76" Canvas.Top="2">
                        <Image Width="92" Height="19" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo2.png"  />
                    </ctrlCommon:AxisCanvas>
                </ctrlCommon:AxisCanvas>
                <ctrlCommon:AxisCanvas x:Name="canvas1" Height="37" Width="209" Canvas.Top="12" Canvas.Left="23" ShowAxisPoint="True">
                    <Image Stretch="None" Width="92" Height="23" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo1.png" Canvas.Top="7" />
                    <ctrlCommon:AxisCanvas x:Name="canvas112" Height="19" Width="92" Canvas.Left="78" Canvas.Top="10">
                        <Image Width="92" Height="19" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo2.png" />
                        <ctrlCommon:AxisCanvas x:Name="canvas113" Height="37" Width="71" Canvas.Left="76" Canvas.Top="-8">
                            <Image Width="71" Height="37" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo4.png" />
                            <efemControls:WaferCtrl WaferData="{Binding Wafer2}" Canvas.Left="19" Canvas.Top="-14" />
                        </ctrlCommon:AxisCanvas>
                    </ctrlCommon:AxisCanvas>
                    <ctrlCommon:AxisCanvas x:Name="canvas122" Height="19" Width="92" Canvas.Left="78"  Canvas.Top="10">
                        <Image Width="92" Height="19" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo2.png" />
                        <ctrlCommon:AxisCanvas x:Name="canvas123" Height="37" Width="71" Canvas.Left="78" Canvas.Top="-8">
                            <Image Width="71" Height="37" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo4.png" />
                            <efemControls:WaferCtrl WaferData="{Binding Wafer1}" Canvas.Left="19" Canvas.Top="-14" />
                        </ctrlCommon:AxisCanvas>
                    </ctrlCommon:AxisCanvas>
                </ctrlCommon:AxisCanvas>
                <Image Width="62" Height="61" Canvas.Top="0" Source="/MECF.Framework.UI.Client;component/ClientControls/RobotControls/DualArmRobot1/rbo3.png"/>
            </ctrlCommon:AxisCanvas>
            <Canvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="rotate" CenterY="30.5" CenterX="31" Angle="0"></RotateTransform>
                    <TranslateTransform  x:Name="translate" X="{Binding TranslateX}"/>
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
    </Viewbox>
</UserControl>
