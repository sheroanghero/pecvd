<Window x:Class="MECF.Framework.UI.Client.Ctrlib.UnitControls.AITChillerInputDialogBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Aitex.Core.UI.Converters;assembly=MECF.Framework.UI.Core"
        Height="210" Width="475" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner" 
        KeyDown="OnEnterKeyIsHit"
        Title="{Binding Path=DeviceName, StringFormat={}{0} SetPoint}">
    <Window.Resources>
        <converters:bool2VisibilityConverter x:Key="Bool2VisibilityConvert"/>
    </Window.Resources>
    <Grid Width="460" Height="240" Margin="9,5,5,0">
        <Grid.Resources>
            <Style TargetType="RadioButton"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="1,1,1,1" Background="LightGray" Grid.Row="0" Grid.Column="0" Padding="5,1">
            <TextBlock Text="Name" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,1,1,1" Background="Transparent" Grid.Row="0" Grid.Column="1" Padding="5,1">
            <TextBlock Text="{Binding DeviceName}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,1,1,1" Background="Transparent" Grid.Row="0" Grid.Column="2" Padding="5,1">
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,1,1,1" Background="Transparent" Grid.Row="0" Grid.Column="3" Padding="5,1">
        </Border>

        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="LightGray" Grid.Row="1" Grid.Column="0" Padding="5,1">
            <TextBlock Text="CH1 Status" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="1" Grid.Column="1" Padding="5,1">
            <TextBlock Text="{Binding CH1Status}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="LightGray" Grid.Row="1" Grid.Column="2" Padding="5,1">
            <TextBlock Text="CH1 Flow(L/min)" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="1" Grid.Column="3" Padding="5,1">
            <TextBlock Text="{Binding CH1Flow}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>



        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="LightGray" Grid.Row="2" Grid.Column="0" Padding="5,1">
            <TextBlock Text="Temp Max(℃)" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="2" Grid.Column="1" Padding="5,1">
            <TextBlock Text="{Binding TemperatureHighLimit}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="LightGray" Grid.Row="2" Grid.Column="2" Padding="5,1">
            <TextBlock Text="Temp Min(℃)" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="2" Grid.Column="3" Padding="5,1">
            <TextBlock Text="{Binding TemperatureLowLimit}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>

        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="LightGray" Grid.Row="3" Grid.Column="0" Padding="5,1">
            <TextBlock Text="CH1 Temp(℃)" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="3" Grid.Column="1" Padding="5,1">
            <TextBlock Text="{Binding CH1Temperature}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="3" Grid.Column="2" Padding="5,1">
            <TextBox Text="{Binding CH1TemperatureSetpoint}" TextWrapping="Wrap" Foreground="Black" FontSize="14" Width="90" Height="25" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="3" Grid.Column="3" Padding="5,1">
            <Button Content="Set" x:Name="_ch1SetTempButton" Foreground="Black" FontSize="14" FontFamily="Arial" Width="80" VerticalAlignment="Center" HorizontalAlignment="Center" Click="CH1TemperatureButton_Click"/>
        </Border>



        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="LightGray" Grid.Row="4" Grid.Column="0" Padding="5,1">
            <TextBlock Text="CH1 On/Off" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="4" Grid.Column="1" Padding="5,1">
            <TextBlock Text="{Binding CH1OnOff}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="4" Grid.Column="2" Padding="5,1">
            <Button Content="Set On" x:Name="_ch1OnButton"  Foreground="Black" FontSize="14" FontFamily="Arial" Width="80" VerticalAlignment="Center" HorizontalAlignment="Center"  Click="CH1OnButton_Click"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="4" Grid.Column="3" Padding="5,1">
            <Button Content="Set Off" x:Name="_ch1OffButton" Foreground="Black" FontSize="14" FontFamily="Arial" Width="80" VerticalAlignment="Center" HorizontalAlignment="Center"  Click="CH1OffButton_Click"/>
        </Border>








        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="LightGray" Grid.Row="5" Grid.Column="0" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBlock Text="CH2 Status" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="5" Grid.Column="1" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBlock Text="{Binding CH2Status}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="LightGray" Grid.Row="5" Grid.Column="2" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBlock Text="CH2 Flow(L/min)" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="5" Grid.Column="3" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBlock Text="{Binding CH2Flow}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>


        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="LightGray" Grid.Row="6" Grid.Column="0" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBlock Text="CH2 Temp(℃)" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="6" Grid.Column="1" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBlock Text="{Binding CH2Temperature}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="6" Grid.Column="2" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBox Text="{Binding CH2TemperatureSetpoint}" TextWrapping="Wrap" Foreground="Black" Width="90" Height="25" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="6" Grid.Column="3" Padding="5,1" Visibility="{Binding IsShow}">
            <Button Content="Set" x:Name="_ch2SetTempButton" Foreground="Black" FontSize="14" FontFamily="Arial" Width="80" VerticalAlignment="Center" HorizontalAlignment="Center" Click="CH2TemperatureButton_Click"/>
        </Border>

        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="LightGray" Grid.Row="7" Grid.Column="0" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBlock Text="CH2 On/Off" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="7" Grid.Column="1" Padding="5,1" Visibility="{Binding IsShow}">
            <TextBlock Text="{Binding CH2OnOff}" TextWrapping="Wrap" Foreground="Black" FontSize="14" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="7" Grid.Column="2" Padding="5,1" Visibility="{Binding IsShow}">
            <Button Content="Set On" x:Name="_ch2OnButton" Foreground="Black" FontSize="14" FontFamily="Arial" Width="80" VerticalAlignment="Center" HorizontalAlignment="Center"  Click="CH2OnButton_Click"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0,0,1,1" Background="Transparent" Grid.Row="7" Grid.Column="3" Padding="5,1" Visibility="{Binding IsShow}">
            <Button Content="Set Off" x:Name="_ch2OffButton" Foreground="Black" FontSize="14" FontFamily="Arial" Width="80" VerticalAlignment="Center" HorizontalAlignment="Center"  Click="CH2OffButton_Click"/>
        </Border>

    </Grid>
    
</Window>
